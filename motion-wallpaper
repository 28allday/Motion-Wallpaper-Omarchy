#!/usr/bin/env bash
# ==============================================================================
# motion-wallpaper — command-line control for the omarchy-shell video-wallpaper
# plugin (nosignal.motion-wallpaper) on Omarchy 4 (Quickshell).
#
# The interactive UI now lives in the shell itself: a bar widget + dropdown
# panel (click the ◐/film icon in the bar). This CLI is the scriptable path —
# for keybinds, SSH, and automation. It is a thin wrapper over the shell IPC:
#   omarchy-shell motion-wallpaper <fn> [args]
#
# Commands:
#   status  (default)     Print current state (per monitor).
#   play <file> [screen]  Set + start a video, everywhere or on one monitor.
#   off <screen>          Blank one monitor, leaving the others playing.
#   screens               List each monitor and the clip it is showing.
#   stop                  Stop; the static wallpaper shows through.
#   toggle                Flip on/off (handy for a keybind).
#   pause | resume        Pause/resume without tearing the surface down.
#   screen <name|all>     Coarse targeting for monitors with no clip of
#                         their own (per-monitor clips override it).
#   clear <screen|all>    Drop a monitor's own clip; it follows the default.
#   autopause <on|off>    Pause the video when a fullscreen window covers it.
#
# State (owned by the plugin): ~/.local/state/motion-wallpaper/state.json
# Log: ~/.cache/motion-wallpaper.log
# ==============================================================================

set -euo pipefail

APP_NAME="Motion Wallpaper"
IPC_TARGET="motion-wallpaper"
LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
LOG_FILE="$LOG_DIR/motion-wallpaper.log"
LOG_MAX_BYTES=$(( 256 * 1024 ))
mkdir -p "$LOG_DIR"

# Opening a FIFO for append blocks until a reader attaches, so a special file
# at the log path would hang every invocation of this CLI for good — the same
# class of bug as reading state through a blocking path. `[ -f ]` stats rather
# than opens, so it answers immediately where the redirect would hang.
#
# `-L` is tested FIRST and on its own, because it is the only one of these
# that does not follow the link. `-e` is *false* for a dangling symlink, so
# gating on `-e` first let a dangling one skip the whole guard — and `>>` then
# follows it and CREATES the out-of-cache target. Order matters more than the
# individual tests here.
if [ -L "$LOG_FILE" ] || { [ -e "$LOG_FILE" ] && [ ! -f "$LOG_FILE" ]; }; then
  LOG_FILE=/dev/null
fi

# Every IPC call appends stderr here, and a keybind pressed against a shell
# that is not running appends on every press — so the log has to be bounded or
# it grows without limit. One rotation keeps the most recent failures, which is
# all this log is ever read for.
rotate_log() {
  local size
  [ -f "$LOG_FILE" ] || return 0
  size=$(stat -c %s "$LOG_FILE" 2>/dev/null) || return 0
  [ "$size" -gt "$LOG_MAX_BYTES" ] || return 0
  mv -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null || : > "$LOG_FILE"
}
rotate_log

TXT_ERR_NO_SHELL="omarchy-shell (Quickshell) isn't running. Start your Omarchy session first."
TXT_ERR_NO_PLUGIN="The motion-wallpaper plugin isn't loaded. Enable it: omarchy plugin enable nosignal.motion-wallpaper"
TXT_ERR_NO_OMARCHY="omarchy-shell was not found on PATH. Motion Wallpaper requires Omarchy 4+."

err() { echo "motion-wallpaper: $*" >&2; }

require_cmd() {
  local c
  for c in "$@"; do command -v "$c" >/dev/null 2>&1 || { err "'$c' is not installed."; exit 1; }; done
}

# All IPC goes through omarchy-shell rather than a raw `qs -p <path>`: it
# resolves OMARCHY_PATH itself, recovers WAYLAND_DISPLAY for callers outside the
# session (ssh, a TTY), and turns IPC-level failures into a nonzero exit.
ipc() { omarchy-shell "$IPC_TARGET" "$@" 2>>"$LOG_FILE"; }

# One read-only probe distinguishes "no shell" from "plugin not enabled" — the
# wrapper reports the latter as "Target not found." on stderr.
require_plugin() {
  command -v omarchy-shell >/dev/null 2>&1 || { err "$TXT_ERR_NO_OMARCHY"; exit 1; }
  local probe
  probe="$(omarchy-shell "$IPC_TARGET" status 2>&1 >/dev/null)" && return 0
  case "$probe" in
    *"Target not found"*|*"Function not found"*) err "$TXT_ERR_NO_PLUGIN" ;;
    *) err "$TXT_ERR_NO_SHELL" ;;
  esac
  exit 1
}

# Derive a single human state word from a status JSON payload on stdin. Reads
# the per-monitor array when there is one, so a setup whose clips are all
# per-monitor (empty top-level videoPath) still reports "playing".
state_word() {
  local j enabled paused exists video nscreens assigned playing missing
  j="$(cat)"
  enabled="$(jq -r '.enabled // false' <<<"$j")"
  paused="$(jq -r '.manualPaused // false' <<<"$j")"
  if [ "$enabled" != "true" ]; then echo stopped; return; fi
  if [ "$paused" = "true" ]; then echo paused; return; fi

  nscreens="$(jq -r '(.screens // []) | length' <<<"$j")"
  if [ "${nscreens:-0}" -gt 0 ]; then
    assigned="$(jq -r '[(.screens // [])[] | select((.video // "") != "")] | length' <<<"$j")"
    playing="$(jq -r '[(.screens // [])[] | select(.playing == true)] | length' <<<"$j")"
    missing="$(jq -r '[(.screens // [])[] | select((.video // "") != "" and (.fileExists // false) != true)] | length' <<<"$j")"
    if [ "$assigned" -eq 0 ]; then echo "no video set"; return; fi
    if [ "$playing" -gt 0 ]; then echo playing; return; fi
    if [ "$missing" -eq "$assigned" ]; then echo "file missing"; return; fi
    echo paused; return    # assigned everywhere, but auto-paused by fullscreen
  fi

  exists="$(jq -r '.videoFileExists // false' <<<"$j")"
  video="$(jq -r '.videoPath // ""' <<<"$j")"
  if [ -z "$video" ]; then echo "no video set"; return; fi
  if [ "$exists" != "true" ]; then echo "file missing"; return; fi
  echo playing
}

# Per-monitor breakdown: one line per connected output. Printed whenever there
# is more than one monitor, or a monitor has been given a clip of its own —
# with per-monitor clips, a single "video:" line no longer tells the story.
screens_table() {
  jq -r '(.screens // [])[] |
    (.name)
    + "\t"
    + (if (.video // "") == "" then "off"
       elif (.fileExists // false) | not then "file missing"
       elif (.playing // false) then "playing"
       else "paused" end)
    + "\t"
    + (if (.video // "") == "" then "-" else (.video | split("/") | last) end)
    + (if (.source // "") == "screen" then "" else "  (default)" end)'
}

cmd_status() {
  require_cmd jq
  require_plugin
  local j; j="$(ipc status 2>/dev/null || echo '{}')"
  local video output pause nscreens noverrides
  video="$(jq -r '.videoPath // ""' <<<"$j")"
  output="$(jq -r '.output // "all"' <<<"$j")"
  pause="$(jq -r '.pauseOnFullscreen // false' <<<"$j")"
  nscreens="$(jq -r '(.screens // []) | length' <<<"$j")"
  noverrides="$(jq -r '(.screenVideos // {}) | length' <<<"$j")"
  [ "$output" = "all" ] && output="all screens"
  printf 'status:     %s\n' "$(state_word <<<"$j")"
  printf 'video:      %s\n' "${video:-(none)}"
  printf 'screen:     %s\n' "$output"
  printf 'auto-pause: %s\n' "$([ "$pause" = "true" ] && echo on || echo off)"
  if [ "${nscreens:-0}" -gt 1 ] || [ "${noverrides:-0}" -gt 0 ]; then
    printf 'screens:\n'
    screens_table <<<"$j" | while IFS=$'\t' read -r name state clip; do
      printf '  %-12s %-12s %s\n' "$name" "$state" "$clip"
    done
  fi
}

cmd_screens() {
  require_cmd jq
  require_plugin
  local j; j="$(ipc status 2>/dev/null || echo '{}')"
  screens_table <<<"$j" | while IFS=$'\t' read -r name state clip; do
    printf '%-12s %-12s %s\n' "$name" "$state" "$clip"
  done
}

# play <file> [screen] — no screen means every monitor (and drops any
# per-monitor clips); with a screen, only that monitor changes.
cmd_play() {
  require_plugin
  local f="${1:-}" s="${2:-}"
  [ -n "$f" ] || { err "usage: motion-wallpaper play <file> [screen]"; exit 1; }
  [ -f "$f" ] || { err "file not found: $f"; exit 1; }
  local p; p="$(readlink -f "$f")"
  if [ -n "$s" ] && [ "$s" != "all" ]; then
    ipc playOn "$s" "$p" >/dev/null
  else
    ipc playAll "$p" >/dev/null
  fi
}

cmd_off() {
  require_plugin
  local s="${1:-}"
  [ -n "$s" ] || { err "usage: motion-wallpaper off <monitor-name>"; exit 1; }
  [ "$s" != "all" ] || { err "use 'motion-wallpaper stop' to blank every screen"; exit 1; }
  ipc playOn "$s" "" >/dev/null
}

cmd_clear() {
  require_plugin
  local s="${1:-}"
  [ -n "$s" ] || { err "usage: motion-wallpaper clear <monitor-name|all>"; exit 1; }
  ipc clearScreen "$s" >/dev/null
}

cmd_screen() {
  require_plugin
  local s="${1:-}"
  [ -n "$s" ] || { err "usage: motion-wallpaper screen <monitor-name|all>"; exit 1; }
  ipc setOutput "$s" >/dev/null
}

cmd_autopause() {
  require_plugin
  case "${1:-}" in
    on|true)   ipc setPauseOnFullscreen true  >/dev/null ;;
    off|false) ipc setPauseOnFullscreen false >/dev/null ;;
    *) err "usage: motion-wallpaper autopause <on|off>"; exit 1 ;;
  esac
}

cmd_speed() {
  require_plugin
  local v="${1:-}"
  case "$v" in
    ""|*[!0-9.]*|*.*.*) err "usage: motion-wallpaper speed <0.25-2>"; exit 1 ;;
  esac
  ipc setSpeed "$v" >/dev/null
}

# rotate <off|all|selected> [shuffle|order] [minutes] [screen]
cmd_rotate() {
  require_plugin
  local mode="${1:-}" order="${2:-}" mins="${3:-}" screen="${4:-}"
  case "$mode" in
    off|all|selected) ;;
    *) err "usage: motion-wallpaper rotate <off|all|selected> [shuffle|order] [minutes] [screen]"; exit 1 ;;
  esac
  case "$order" in
    ""|shuffle) order=shuffle ;;
    order|sequential) order=sequential ;;
    *) err "order must be 'shuffle' or 'order'"; exit 1 ;;
  esac
  if [ -n "$screen" ] && [ "$screen" != "all" ]; then
    ipc setRotationOn "$screen" "$mode" "$order" "$mins" >/dev/null
  else
    ipc setRotation "$mode" "$order" "$mins" >/dev/null
  fi
}

# playlist <screen|all> <file...>
cmd_playlist() {
  require_plugin
  local screen="${1:-}"; shift || true
  [ -n "$screen" ] || { err "usage: motion-wallpaper playlist <screen|all> <file>..."; exit 1; }
  [ "$#" -gt 0 ] || { err "usage: motion-wallpaper playlist <screen|all> <file>..."; exit 1; }
  local joined="" f p
  for f in "$@"; do
    p="$(readlink -f "$f")" || { err "no such file: $f"; exit 1; }
    [ -f "$p" ] || { err "no such file: $f"; exit 1; }
    joined="${joined:+$joined:}$p"
  done
  if [ "$screen" = "all" ]; then
    ipc setPlaylist "$joined" >/dev/null
  else
    ipc setPlaylistOn "$screen" "$joined" >/dev/null
  fi
}

cmd_next() {
  require_plugin
  local s="${1:-}"
  if [ -n "$s" ] && [ "$s" != "all" ]; then ipc nextOn "$s" >/dev/null
  else ipc next >/dev/null; fi
}

cmd_follow() {
  require_plugin
  local s="${1:-}"
  [ -n "$s" ] || { err "usage: motion-wallpaper follow <screen>"; exit 1; }
  ipc clearRotationOn "$s" >/dev/null
}

case "${1:-status}" in
  status|"") cmd_status ;;
  screens)   cmd_screens ;;
  play)      shift; cmd_play "${1:-}" "${2:-}" ;;
  off)       shift; cmd_off "${1:-}" ;;
  clear)     shift; cmd_clear "${1:-}" ;;
  stop)      require_plugin; ipc stop   >/dev/null ;;
  toggle)    require_plugin; ipc toggle >/dev/null ;;
  pause)     require_plugin; ipc pause  >/dev/null ;;
  resume)    require_plugin; ipc resume >/dev/null ;;
  screen)    shift; cmd_screen "${1:-}" ;;
  autopause) shift; cmd_autopause "${1:-}" ;;
  speed)     shift; cmd_speed "${1:-}" ;;
  rotate)    shift; cmd_rotate "${1:-}" "${2:-}" "${3:-}" "${4:-}" ;;
  playlist)  shift; cmd_playlist "$@" ;;
  next)      shift; cmd_next "${1:-}" ;;
  follow)    shift; cmd_follow "${1:-}" ;;
  -h|--help)
    cat <<USAGE
$APP_NAME — control the omarchy-shell video wallpaper plugin.
The interactive UI is the bar widget + panel (click the film icon in the bar).

Usage: ${0##*/} [command]
  status                Print current state, per monitor (default).
  screens               List each monitor and the clip it is showing.
  play <file> [screen]  Start a video everywhere, or on one monitor.
  off <screen>          Blank one monitor; the others keep playing.
  clear <screen|all>    Drop a monitor's own clip; follow the default again.
  stop                  Stop; static wallpaper shows through.
  toggle                Flip on/off (good for a keybind).
  pause | resume        Pause/resume playback.
  screen <name|all>     Coarse targeting for monitors with no clip of their own.
  autopause <on|off>    Pause video under fullscreen windows.
  speed <0.25-2>        Playback speed, e.g. 1, 0.5, 0.66.

Rotation (off by default — one clip until you turn it on):
  rotate <off|all|selected> [shuffle|order] [minutes] [screen]
  playlist <screen|all> <file>...   Clips for "selected" mode.
  next [screen]         Skip ahead without waiting out the interval.
  follow <screen>       Drop a screen's own settings; follow the default.

Each screen can rotate differently — shuffle on one, fixed on the other:
  ${0##*/} rotate all shuffle 5 DP-1
  ${0##*/} rotate off "" "" DP-2

Different clips on different screens:
  ${0##*/} play ~/Videos/a.mp4 DP-1
  ${0##*/} play ~/Videos/b.mp4 HDMI-A-1
  ${0##*/} off DP-2          # that one stays on the static wallpaper

A playing wallpaper resumes automatically after reboot — no autostart step.
USAGE
    ;;
  *) err "unknown command: $1 (try --help)"; exit 1 ;;
esac
